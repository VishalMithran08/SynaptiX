# Datasets — never commit. The training set is thousands of .npy files.
train/
train_new/
Test_NoisyLR/
data_raw/
*.zip
*.tar
*.tar.gz
*.7z

# Training run directories. These hold 100MB+ checkpoints each and would blow
# past GitHub's 100MB per-file limit. Only weights/ is committed.
checkpoints*/
!weights/
runs/
*.log

# Large checkpoints anywhere other than weights/
/*.pth
/*.pt
/*.ckpt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Demo / scratch run artifacts. These are regenerated on demand and were
# committed by accident once (105 MB).
demo_output/
demo_400/
results/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

